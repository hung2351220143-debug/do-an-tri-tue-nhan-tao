# ================================
# CẤU HÌNH MÔI TRƯỜNG
# Sao chép file này thành .env và điền thông tin
# ================================

# Server
PORT=5000
NODE_ENV=development

# Database (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=waste_classifier

# JWT Secret (đổi thành chuỗi ngẫu nhiên dài)
JWT_SECRET=waste_classifier_super_secret_key_2024_change_this

# JWT Expiry
JWT_EXPIRES_IN=7d

# Google Gemini API Key
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Frontend URL (cho CORS)
FRONTEND_URL=http://localhost:5173
